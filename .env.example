# Copy to .env and fill in. .env, secrets/ and data/ are git-ignored.

# --- Google Maps Platform (geocoding via Places API (New) Text Search) -----
# Use ONE of these two. If both are set, the service account is used.
# (a) Service account JSON key; its project must have the Places API (New) enabled.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/smartsolarvn-secret.json
# (b) API key with the Places API (New) enabled.
GOOGLE_MAPS_API_KEY=

# --- Facebook (throwaway account only, never a personal one) ---------------
# Log in to the account in a browser, export its cookies as JSON with the
# Cookie-Editor extension (Export -> JSON), and save the file at this path.
FB_COOKIES_FILE=secrets/facebook_cookies.json
# Scraper's cached operation ids + session token (created automatically).
FB_STATE_FILE=secrets/facebook_state.json
# Optional proxy, e.g. http://user:pass@host:port (the scraper library turns off
# TLS verification when a proxy is set).
FB_PROXY=
# Requests per run = queries x pages. Default 13 x 2 = up to 26 per run.
FB_MAX_QUERIES_PER_RUN=13
FB_PAGES_PER_QUERY=2
FB_REQUEST_DELAY_SECONDS=4
# Ask Facebook for recent posts first (experimental; set 0 if searches start failing).
FB_RECENT_FILTER=1

# --- Collection ------------------------------------------------------------
ENABLE_GOOGLE_NEWS=1
# Appended to the city-wide keyword searches: "ngập TPHCM", "tai nạn TPHCM", ...
CITY_SUFFIX=TPHCM
# Only keep posts newer than this.
LOOKBACK_MINUTES=180
DATA_DIR=data
MAP_DIR=map
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
