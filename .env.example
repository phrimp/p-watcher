# Copy to .env and fill in. .env and secrets/ are git-ignored.

# --- Google Maps Platform -------------------------------------------------
# Use ONE of these two. If both are set, the service account is used.
# (a) Service account JSON key file; its project must have the Routes API enabled.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/smartsolarvn-secret.json
# (b) API key with the Routes API enabled (restrict it to the Routes API).
GOOGLE_MAPS_API_KEY=
# DRIVE or TWO_WHEELER (motorbike routing; check it is available for your area)
ROUTES_TRAVEL_MODE=DRIVE
ROUTES_LANGUAGE=vi
ROUTES_REGION=vn

# --- Facebook (throwaway account only, never a personal one) ---------------
# Log in to the account in a browser, export its cookies as JSON with the
# Cookie-Editor extension (Export -> JSON), and save the file at this path.
# No email/password here: the scraper uses session cookies only, and password
# logins from a server trigger Facebook checkpoints.
FB_COOKIES_FILE=secrets/facebook_cookies.json
# Scraper's cached operation ids + session token (created automatically).
FB_STATE_FILE=secrets/facebook_state.json
# Optional proxy, e.g. http://user:pass@host:port (TLS verification is turned
# off by the scraper library when a proxy is set).
FB_PROXY=
# Keep these low to avoid getting the account rate-limited or banned.
FB_MAX_QUERIES=4
FB_RESULTS_PER_QUERY=8
FB_REQUEST_DELAY_SECONDS=3

# --- Detection / search ----------------------------------------------------
# Minimum length of a red stretch to count as a jam.
MIN_JAM_LENGTH_M=200
# Only keep posts newer than this.
LOOKBACK_MINUTES=120
ENABLE_GOOGLE_NEWS=1
# OpenStreetMap reverse geocoding, used to name the jam location.
ENABLE_NOMINATIM=1
NOMINATIM_USER_AGENT=project-observe-prototype/0.1
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
